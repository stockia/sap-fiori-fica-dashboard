<mvc:View controllerName="com.stocki.ficadashboard.controller.Main"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core">

    <!-- <App id="app"> -->
        <Page id="page" title="{i18n>appTitle}">
            <headerContent>
                <Button id="userMenuButton" icon="sap-icon://account" tooltip="{i18n>userMenuTitle}" press="onOpenUserMenu"/>
            </headerContent>
            
            <content>
                <core:Fragment fragmentName="com.stocki.ficadashboard.view.fragments.KPIHeader" type="XML"/>

                <Table id="idProductsTable"
                    inset="false"
                    items="{fica>/BusinessPartners}"
                    class="sapUiResponsiveMargin"
                    width="auto">
                    
                    <headerToolbar>
                        <Toolbar id="tableToolbar">
                            <Title id="tableTitle" text="{i18n>tableTitle} ({= ${fica>/BusinessPartners}.length})" level="H2"/>
                            <ToolbarSpacer id="tableSpacer"/>
                            <SearchField id="searchField" width="30%" placeholder="{i18n>searchPlaceholder}" search="onSearch"/>
                        </Toolbar>
                    </headerToolbar>

                    <columns>
                        <Column id="columnBP" >
                            <Text id="textBP" text="{i18n>columnBP}" />
                        </Column>
                        <Column id="columnCity" minScreenWidth="Tablet" demandPopin="true">
                            <Text id="textCity" text="{i18n>columnCity}" />
                        </Column>
                        <Column id="columnAccount" minScreenWidth="Tablet" demandPopin="true">
                            <Text id="textAccount" text="{i18n>columnAccount}" />
                        </Column>
                        <Column id="columnAmount" hAlign="End">
                            <Text id="textAmount" text="{i18n>columnAmount}" />
                        </Column>
                        <Column id="columnStatus" hAlign="Center">
                            <Text id="textStatus" text="{i18n>columnStatus}" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem id="columnListItem" type="Navigation" press="onPressBP">
                            <cells>
                                <ObjectIdentifier id="objectIdentifier" title="{fica>name}" text="ID: {fica>bpId}"/>
                                <Text id="textCityList" text="{fica>city}"/>
                                <Text id="textAccountList" text="{fica>contractAccount}"/>
                                <ObjectNumber
                                    id="objectNumber"
                                    number="{
                                        parts:[{path:'fica>totalAmount'},{path:'fica>currency'}],
                                        type: 'sap.ui.model.type.Currency',
                                        formatOptions: {showMeasure: true}
                                    }"
                                    state="{= ${fica>dunningLevel} === 1 ? 'Success' : ${fica>dunningLevel} === 2 ? 'Warning' :'Error' }" />
                                <ObjectStatus
                                    id="objectStatus"
                                    text="{fica>statusText}"
                                    state="{fica>status}"
                                    icon="{= ${fica>status} === 'Error' ? 'sap-icon://error' : 'sap-icon://sys-enter-2' }" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </content>
        </Page>
    <!-- </App> -->
</mvc:View>