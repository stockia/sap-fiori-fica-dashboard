<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <HeaderContainer scrollStep="200" showDividers="false" class="sapUiSmallMargin">
        <TileContent footer="{i18n>kpiTotalDebt}">
            <NumericContent value="{fica>/Stats/totalDebt}" icon="sap-icon://money-bills" valueColor="Error" />
        </TileContent>
        <TileContent footer="{i18n>kpiCritical}">
            <NumericContent value="{fica>/Stats/criticalAccounts}" icon="sap-icon://alert" valueColor="Critical" />
        </TileContent>
        <TileContent footer="{i18n>kpiDunning}">
            <NumericContent value="{fica>/Stats/activeDunningRuns}" icon="sap-icon://waiver" />
        </TileContent>
    </HeaderContainer>
</core:FragmentDefinition>